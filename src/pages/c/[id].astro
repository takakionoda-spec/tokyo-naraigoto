---
import Base from '../../layouts/Base.astro';
import classrooms from '../../data/classrooms.json';

export function getStaticPaths() {
  return classrooms.map((c) => ({ params: { id: c.id }, props: { c } }));
}

const { c } = Astro.props;
const AREA_LABELS = { wangan: '湾岸エリア', setagaya: '世田谷エリア', nerima: '練馬エリア' };
const CATEGORY_LABELS = { learning: '学び', language: '語学', sports: 'スポーツ', other: 'その他' };
const NICHE_LABELS = {
  international: 'インターに通う・目指す',
  sports: 'スポーツでのびのび',
  juken: '中学受験を予定・検討中',
};
// パートナー特典：競合教室（PR枠）を非表示
const rivals = c.partner
  ? []
  : classrooms.filter((x) => x.id !== c.id && x.area === c.area).slice(0, 3);

const ld = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: c.name,
  description: c.description,
  address: { '@type': 'PostalAddress', addressRegion: '東京都', streetAddress: c.address },
  url: c.url,
};
---
<Base title={`${c.name}｜${AREA_LABELS[c.area]}の${CATEGORY_LABELS[c.category]}・子どもの習い事｜TOKYO習い事.com`} description={c.description.slice(0, 120)}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
  <main class="mx-auto max-w-3xl px-4 py-10">
    <nav class="text-xs text-slate-500">
      <a href="/" class="hover:underline">TOKYO習い事.com</a> ›
      <a href={`/#classrooms`} class="hover:underline">{AREA_LABELS[c.area]}</a> ›
      <span class="text-slate-700">{c.name}</span>
    </nav>

    <article class={`mt-4 rounded-3xl border bg-white p-6 shadow-sm sm:p-8 ${c.partner ? 'border-amber-300 ring-2 ring-amber-300/70' : 'border-slate-200'}`}>
      <div class="flex flex-wrap gap-1.5">
        {c.partner && <span class="rounded-full bg-amber-400 px-2.5 py-0.5 text-[11px] font-extrabold text-amber-950">★ 公式パートナー</span>}
        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600">{AREA_LABELS[c.area]}</span>
        <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-[11px] font-bold text-indigo-700">{CATEGORY_LABELS[c.category]}</span>
      </div>
      <h1 class="mt-3 text-2xl font-extrabold text-slate-900">{c.name}</h1>
      <dl class="mt-5 grid gap-2 text-sm sm:grid-cols-2">
        <div><dt class="font-bold text-slate-400">アクセス</dt><dd class="mt-0.5 text-slate-700">{c.station}</dd></div>
        <div><dt class="font-bold text-slate-400">住所</dt><dd class="mt-0.5 text-slate-700">{c.address}</dd></div>
        <div><dt class="font-bold text-slate-400">対象年齢</dt><dd class="mt-0.5 text-slate-700">{c.ages}</dd></div>
        <div><dt class="font-bold text-slate-400">料金目安</dt><dd class="mt-0.5 text-slate-700">{c.price}</dd></div>
      </dl>
      <p class="mt-5 leading-relaxed text-slate-600">{c.description}</p>
      {c.niche.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {c.niche.map((n) => (
            <span class="rounded-md bg-sky-50 px-2 py-0.5 text-xs font-semibold text-sky-700"># {NICHE_LABELS[n]}</span>
          ))}
        </div>
      )}
      <div class="mt-7 flex flex-col gap-2 sm:flex-row">
        <a href={c.url} target="_blank" rel="noopener nofollow" class="flex-1 rounded-xl bg-sky-600 px-4 py-3 text-center text-sm font-bold text-white hover:bg-sky-500">公式サイトを見る</a>
        <a href="/#owner" class="flex-1 rounded-xl border border-slate-300 px-4 py-3 text-center text-sm font-bold text-slate-700 hover:bg-slate-50">この教室の情報を修正する</a>
      </div>
    </article>

    {rivals.length > 0 && (
      <aside class="mt-8">
        <p class="text-xs font-bold text-slate-400">PR｜{AREA_LABELS[c.area]}の近くの教室</p>
        <div class="mt-2 grid gap-3 sm:grid-cols-3">
          {rivals.map((r) => (
            <a href={`/c/${r.id}/`} class="rounded-2xl border border-slate-200 bg-white p-4 text-sm shadow-sm hover:border-sky-300">
              <p class="font-bold text-slate-800">{r.partner ? '★ ' : ''}{r.name}</p>
              <p class="mt-1 text-xs text-slate-500">{r.station}</p>
            </a>
          ))}
        </div>
      </aside>
    )}
  </main>
</Base>
